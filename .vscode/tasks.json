{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build 3D Sorting Visualizer",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "main.cpp",
        "-I",
        "C:/raylib-6.0_win64_mingw-w64/raylib-6.0_win64_mingw-w64/include",
        "-I",
        "C:/raylib-6.0_win64_mingw-w64/include",
        "-L",
        "C:/raylib-6.0_win64_mingw-w64/raylib-6.0_win64_mingw-w64/lib",
        "-L",
        "C:/raylib-6.0_win64_mingw-w64/lib",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-o",
        "${workspaceFolder}/sorting_visualizer.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
